# =============================================================================
# AEGIX (SOC-AI Assistant) — Environment Configuration Template
# File path: .env.example (Copy to .env and fill in your laboratory credentials)
# Strictly adheres to Table 4-9 (Accounts) and Section 4.5.5 (Secrets Management)
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Application & Network Settings
# -----------------------------------------------------------------------------
AEGIX_ENV=lab
FRONTEND_ORIGIN=http://localhost:5173
USE_MOCK_INTEGRATIONS=false

# -----------------------------------------------------------------------------
# 2. Database & Storage Configuration (Section 4.2 & Decision D7)
# -----------------------------------------------------------------------------
DATABASE_URL=sqlite:///./aegix.db
FIELD_CATALOGUE_PATH=backend/data/field_catalogue.json
REPORTS_OUTPUT_DIR=backend/reports

# -----------------------------------------------------------------------------
# 3. Authentication & Sessions (Section 4.5.2 & Decision D9)
# Generate a strong 32+ character random secret for JWT signing in lab:
# Linux/Mac terminal: openssl rand -hex 32
# -----------------------------------------------------------------------------
JWT_SECRET_KEY=replace_with_a_secure_random_hex_string_min_32_chars

# -----------------------------------------------------------------------------
# 4. Account 1: LLM Provider API (Table 4-9 — Inference only, replaceable)
# -----------------------------------------------------------------------------
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=sk-proj-your_openai_api_key_here
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_SEC=30

# -----------------------------------------------------------------------------
# 5. Account 2: Splunk Read-Only Account (Table 4-9 — Search only, no write/admin)
# Used exclusively by Splunk Tool (REST port default 8089)
# -----------------------------------------------------------------------------
SPLUNK_HOST=https://192.168.1.100:8089
SPLUNK_READ_TOKEN=your_splunk_bearer_token_here
SPLUNK_READ_USER=aegix_read
SPLUNK_READ_PASS=your_splunk_readonly_password_here
SPLUNK_VERIFY_SSL=false
SPL_ALLOWED_INDEXES=main,windows,sysmon,wazuh,network,security

# -----------------------------------------------------------------------------
# 6. Account 3: Wazuh Read Account (Table 4-9 — Read alerts & agent info only)
# Used exclusively by Wazuh Read Tool (API port default 55000)
# -----------------------------------------------------------------------------
WAZUH_API_URL=https://192.168.1.101:55000
WAZUH_READ_USER=aegix_reader
WAZUH_READ_PASS=your_wazuh_reader_password_here
WAZUH_VERIFY_SSL=false

# -----------------------------------------------------------------------------
# 7. Account 4: Wazuh Action Account (Table 4-9 — SEPARATE account for Action Executor)
# Strictly unexposed to the agent; invoked ONLY by Approval Service after Gates G1-G4 pass
# -----------------------------------------------------------------------------
WAZUH_ACTION_USER=aegix_actor
WAZUH_ACTION_PASS=your_wazuh_action_password_here
WAZUH_ISOLATION_MODE=custom_script
WAZUH_ISOLATE_COMMAND=isolate-endpoint
WAZUH_RELEASE_COMMAND=release-endpoint

# -----------------------------------------------------------------------------
# 8. Account 5: VirusTotal API Key (Table 4-9 — Indicator lookups only)
# Strictly forbids file uploads (hash, ip, domain, url only)
# -----------------------------------------------------------------------------
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here
VIRUSTOTAL_BASE_URL=https://www.virustotal.com/api/v3
VIRUSTOTAL_RATE_LIMIT_PER_MIN=4
